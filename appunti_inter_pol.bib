@article{bechtelInterestsNormsSupport2019,
  title = {Interests, {{Norms}} and {{Support}} for the {{Provision}} of {{Global Public Goods}}: {{The Case}} of {{Climate Co-operation}}},
  shorttitle = {Interests, {{Norms}} and {{Support}} for the {{Provision}} of {{Global Public Goods}}},

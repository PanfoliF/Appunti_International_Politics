@article{sechserCrisisBargainingNuclear2013,
  title = {Crisis {{Bargaining}} and {{Nuclear Blackmail}}},
  author = {Sechser, Todd S. and Fuhrmann, Matthew},
  date = {2013-01},
  journaltitle = {International Organization},
  shortjournal = {Int Org},
  volume = {67},
  number = {1},

  title = {Climate {{Change Politics}}},
  author = {Bernauer, Thomas},
  date = {2013-05-11},
  journaltitle = {Annual Review of Political Science},
  shortjournal = {Annu. Rev. Polit. Sci.},
  volume = {16},
  number = {1},
  pages = {421--448},

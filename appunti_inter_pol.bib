@article{leschNormViolationsNorm2023,
  title = {From {{Norm Violations}} to {{Norm Development}}: {{Deviance}}, {{International Institutions}}, and the {{Torture Prohibition}}},
  shorttitle = {From {{Norm Violations}} to {{Norm Development}}},
  author = {Lesch, Max},
  date = {2023-06-14},
  journaltitle = {International Studies Quarterly},
  volume = {67},
  number = {3},
  pages = {sqad043},
